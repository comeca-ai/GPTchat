{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cnpj-chat-br",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "cnpj-chat-db",
    "database_id": "SUBSTITUA_PELO_ID_DO_D1",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{
    "binding": "SNAPSHOTS",
    "bucket_name": "cnpj-snapshots"
  }],
  "kv_namespaces": [{
    "binding": "CACHE",
    "id": "SUBSTITUA_PELO_ID_DO_KV"
  }],
  "vectorize": [{
    "binding": "CNAE_INDEX",
    "index_name": "cnpj-cnae-index"
  }],
  "queues": {
    "producers": [{
      "binding": "IMPORT_QUEUE",
      "queue": "cnpj-import"
    }]
  },
  "vars": {
    "APP_NAME": "CNPJ Aberto",
    "LLM_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "DATA_MODE": "d1",
    "R2_BUCKET_NAME": "cnpj-snapshots",
    "DATA_NAMESPACE": "cnpj",
    "CF_ACCOUNT_ID": "SUBSTITUA_PELO_ACCOUNT_ID"
  }
}
